# Configurazione deploy Neocities.
# Copia questo file in .env.deploy (ignorato da Git) e compila i valori.
# Non committare mai la API key.

# Nome del sito: solo la parte prima di .neocities.org
NEOCITIES_SITE=iltuosito

# API key: Neocities -> Settings -> API key
NEOCITIES_API_KEY=incolla_qui_la_tua_api_key
